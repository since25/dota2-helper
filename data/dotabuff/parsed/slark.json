    {
      "index": 0,
      "name": "能量转移",
      "hotkey": "",
      "isInnate": true,
      "abilityType": "",
      "affects": "",
      "damageType": "",
      "piercesDebuffImmunity": "",
      "dispellable": "",
      "description": "斯拉克的攻击会偷走敌方英雄的生命能量，每次吸取他们的1点全属性并转化成自身额外3点敏捷值。只要敌方英雄带着该效果在斯拉克300范围内阵亡，他将永久窃取1点敏捷。\n属性值最少为1点。\n斯拉克或受到作用的单位死亡后，阵亡单位因能量转移变化的属性值将回归正常。但是两方的属性值相互独立，并无关联。\n斯拉克无需完成击杀就能永久窃取敏捷，只要敌方英雄身上拥有能量转移状态时在斯拉克的窃取范围内阵亡即可。\n破坏会使技能无法获得临时的叠加效果。依然可以获得永久的叠加效果。\n破坏不会使现有叠加效果提供的加成失效。\n每攻击一次敌人，斯拉克对他们的弱点就多了解一分。",
      "fields": [
        {
          "label": "持续时间",
          "value": "10"
        },
        {
          "label": "窃取范围",
          "value": "300"
        }
      ],
      "allFields": [
        {
          "label": "持续时间",
          "value": "10"
        },
        {
          "label": "窃取范围",
          "value": "300"
        }
      ],
      "resourceLines": [],
      "flavorText": "每攻击一次敌人，斯拉克对他们的弱点就多了解一分。",
      "englishName": "Essence Shift"
    },
